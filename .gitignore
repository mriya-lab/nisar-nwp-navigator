# Ignore raw data granules
data/raw/*
!data/raw/.gitkeep

# Ignore processed data outputs
data/processed/*
!data/processed/.gitkeep
!data/processed/*.tif
!data/processed/manifest.json
data/gis/*
!data/gis/.gitkeep
!data/gis/*.geojson

# Standard Python ignores
__pycache__/
*.pyc
.env
venv/
.streamlit/
data/raw/*.h5
